{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monolythium Wallet",
  "version": "0.1.0",
  "identifier": "com.monolythium.wallet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monolythium Wallet",
        "width": 412,
        "height": 892,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Finance",
    "shortDescription": "Self-custodial post-quantum wallet for Monolythium",
    "longDescription": "Self-custodial mobile wallet for the Monolythium network. Post-quantum ML-DSA-65 signing, encrypted mempool, platform keychain + biometric vault. Send and receive LYTH, manage accounts, and connect to Monolythium dApps."
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "host": "wallet.monolythium.io",
          "pathPrefix": [
            "/send",
            "/sign",
            "/wc"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "monolythium",
          "lyth"
        ]
      },
      "schemes": [
        "monolythium",
        "lyth"
      ]
    }
  }
}
