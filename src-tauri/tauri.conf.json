{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monolythium Wallet Mobile",
  "version": "0.0.1",
  "identifier": "com.monolythium.wallet.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monolythium Wallet",
        "width": 412,
        "height": 892,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Finance",
    "shortDescription": "Monolythium mobile wallet",
    "longDescription": "Monolythium mobile wallet (iOS + Android) built on Tauri 2 mobile. Hold and move MNLX from a phone, with platform keychain integration and biometric unlock."
  }
}
